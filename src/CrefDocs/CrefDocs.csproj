<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>crefdocs</ToolCommandName>

    <PackageId>CrefDocs.Tool</PackageId>
    <Version>0.1.0</Version>
    <Title>CrefDocs</Title>
    <Authors>IcySnex</Authors>
    <Description>Generate linked Markdown API reference documentation for .NET projects.</Description>
    <PackageReleaseNotes>Initial release with deterministic API snapshots and linked Markdown rendering for flat, namespace and source-folder structures.</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/IcySnex/CrefDocs</PackageProjectUrl>
    <RepositoryUrl>https://github.com/IcySnex/CrefDocs</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>documentation;markdown;api-reference;dotnet-tool;xml-docs</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CrefDocs.Tests" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <PackageReference Include="Microsoft.Build.Framework" Version="17.11.48" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
  </ItemGroup>
</Project>
